{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for cassette.fm desktop",
  "windows": ["main", "*"],
  "permissions": [
    "core:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://*/**" },
        { "url": "http://*/**" }
      ]
    }
  ]
}
