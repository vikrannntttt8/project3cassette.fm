{
  "expo": {
    "name": "cassette.fm",
    "slug": "cassette-fm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cassette",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fm.cassette.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e0e0e"
      },
      "package": "fm.cassette.mobile",
      "permissions": [
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "react-native-track-player"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5a79b417-4467-432a-94ea-3ba14c7f9b92"
      }
    }
  }
}
