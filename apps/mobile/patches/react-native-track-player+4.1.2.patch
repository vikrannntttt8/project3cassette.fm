--- /dev/null
+++ b/node_modules/react-native-track-player/app.plugin.js
@@ -0,0 +1,20 @@
+const { createRunOncePlugin, withInfoPlist } = require('@expo/config-plugins');
+
+let pkg = { name: 'react-native-track-player', version: '4.1.2' };
+try {
+  pkg = require('./package.json');
+} catch {}
+
+function withTrackPlayer(config) {
+  return withInfoPlist(config, (modConfig) => {
+    if (!modConfig.modResults.UIBackgroundModes) {
+      modConfig.modResults.UIBackgroundModes = [];
+    }
+    if (!modConfig.modResults.UIBackgroundModes.includes('audio')) {
+      modConfig.modResults.UIBackgroundModes.push('audio');
+    }
+    return modConfig;
+  });
+}
+
+module.exports = createRunOncePlugin(withTrackPlayer, pkg.name, pkg.version);
